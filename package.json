{
  "name": "sharp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Database-native, semantically-aware version control system for agentic software development",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun run test:harness && bun run test:differential",
    "test:harness": "bun --bun vitest run tests/harness",
    "test:differential": "bun run tests/harness/run.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build:server": "bun build --compile --target=bun apps/server/src/index.ts --outfile dist/sharp-server",
    "build:client": "bun build --compile --target=bun apps/client/src/cli.ts --outfile dist/sharp",
    "build": "mkdir -p dist && bun run build:server && bun run build:client",
    "docker:build": "docker build -t sharp-server -f apps/server/Dockerfile .",
    "pg:up": "docker compose up -d postgres",
    "pg:down": "docker compose down",
    "pg:logs": "docker compose logs -f postgres",
    "bench": "bun apps/server/bench/run.ts",
    "bench:json": "bun apps/server/bench/run.ts --json bench-report.json"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "postgres": "^3.4.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.22",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  }
}
