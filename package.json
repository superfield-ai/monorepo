{
  "name": "superfield",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun packages/cli/bin/superfield.ts start",
    "build": "bun run --filter '*' build",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun --bun vitest run --reporter=verbose packages/*/tests/unit",
    "test:integration": "bun --bun vitest run --reporter=verbose packages/*/tests/integration",
    "typecheck": "tsc --noEmit",
    "lint": "bunx eslint .",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "msw": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
