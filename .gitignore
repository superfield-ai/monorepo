node_modules/
dist/
.env
*.js.map

# Python bytecode
__pycache__/
*.pyc

# Local trained-model checkpoints (regenerated by run_spike.py)
experiments/*/results/*_trained_model.pt

# Large model artifacts under experiment results/ — JSON envelopes and
# small PNG plots are kept; ONNX models, NumPy weight archives, and
# raw run logs are regenerated by run_area7.py / run_spike.py.
experiments/*/results/*.onnx
experiments/*/results/*.npz
experiments/*/results/*.log

# Local CPU model weight cache (issue #105). The pinned identity and
# SHA-256 checksums live in models/manifest.json (committed). Weights
# are fetched on demand via `npm run fetch-model` and are NOT committed.
models/cache/
