#!/usr/bin/env bash
set -euo pipefail

LOG_PATH="${CLAUDE_E2E_LOG_PATH:-/tmp/claude-studio-test.log}"
SESSION_ID="${CLAUDE_E2E_SESSION_ID:-}"
RESUME_SESSION_ID=""

prev=""
for arg in "$@"; do
  if [[ "$prev" == "--resume" ]]; then
    RESUME_SESSION_ID="$arg"
    break
  fi
  prev="$arg"
done

if [[ -n "$RESUME_SESSION_ID" ]]; then
  SESSION_ID="$RESUME_SESSION_ID"
fi
if [[ -z "$SESSION_ID" ]]; then
  SESSION_ID="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || true)"
fi

printf "ARGS: %s\n" "$*" >> "$LOG_PATH"
if [[ "${1:-}" == "-p" ]]; then
  printf "PROMPT: %s\n" "${2:-}" >> "$LOG_PATH"
fi

if [[ "${CLAUDE_E2E_EXIT_1:-}" == "1" ]]; then
  printf "STDERR: simulated claude failure\n" >&2
  exit 1
fi

# Golden scenario support: when CLAUDE_STUDIO_GOLDEN is set, load a pre-recorded
# fixture file so tests can run against realistic multi-line Claude output without
# a live API key.  The golden file must be in the same directory as this stub
# under studio-goldens/<scenario>.json and must be a valid Claude JSON result.
STUB_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -n "${CLAUDE_STUDIO_GOLDEN:-}" ]] && [[ " $* " == *" --output-format json "* ]]; then
  GOLDEN_FILE="${STUB_DIR}/studio-goldens/${CLAUDE_STUDIO_GOLDEN}.json"
  if [[ -f "$GOLDEN_FILE" ]]; then
    cat "$GOLDEN_FILE"
    exit 0
  fi
fi

if [[ " $* " == *" --output-format json "* ]]; then
  cat <<JSON
{"type":"result","subtype":"success","is_error":false,"session_id":"${SESSION_ID:-11111111-1111-4111-8111-111111111111}","result":"Mocked Claude response for studio tests.","cost_usd":0.012,"duration_ms":1,"num_turns":1}
JSON
else
  echo "Mocked Claude response for studio tests."
fi
