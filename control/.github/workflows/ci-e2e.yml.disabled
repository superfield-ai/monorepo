name: E2E Tests

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
  schedule:
    - cron: '0 3 * * *'

jobs:
  test-e2e:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Start k3s cluster
        uses: nolar/setup-k3d-k3s@v1
        with:
          version: v1.29
          github-token: ${{ secrets.GITHUB_TOKEN }}
          k3s-args: "--disable=traefik@server:0"

      - uses: ./.github/actions/setup-bun

      - name: Build studio container image
        run: docker build -t calypso-studio:e2e .

      - name: Import image into k3d
        run: k3d image import calypso-studio:e2e

      - name: Install Playwright browsers
        run: bunx playwright install chromium --with-deps

      - name: Run E2E tests
        run: bunx playwright test

      - name: Upload studio pod logs
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: studio-pod-logs
          path: /tmp/studio-pod-logs/
          if-no-files-found: ignore

      - name: Upload Playwright report
        uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: playwright-report
          path: playwright-report/
