# Phase-2 dev-scout (issue #79): GPU runtime container SPEC.
#
# This Dockerfile is the canonical specification of the GPU runtime that
# downstream phase-2 issues consume:
#
#   - #13 (Area 6: GPU acceleration)
#   - #18 (Area 7: differentiable graph full run)
#
# The scout PR does NOT build or push the image. CI is CPU-only, and we
# explicitly do not want to commit a 4 GB CUDA layer to the registry until a
# downstream issue has a real workload to validate it against. The file is
# kept here so that:
#
#   1. Both consuming issues build against the same base layer + tool
#      versions (no drift between #13 and #18).
#   2. The build can be reproduced locally on a CUDA host with:
#        docker build -f docker/Dockerfile.gpu -t nexum/runtime-gpu:dev .
#   3. The first downstream issue that actually needs the image flips on
#      the build/push step in `.github/workflows/experiments-harness.yml`.
#
# Canonical references:
#   - docs/research.md (Area 6 GPU acceleration; Area 7 differentiable graph)
#   - docs/engineering.md (Phase-2 Scout Seams → GPU runtime container)

# Base on the AGE Postgres image so the GPU runtime can run the same graph
# extension the CPU pipeline uses. The phase-1 scout (#78) already pinned
# apache/age:PG16_latest in docker-compose.yml; keep them in lockstep.
FROM apache/age:PG16_latest AS pg-age

# Pull CUDA runtime + cuDNN from the canonical NVIDIA image. We use -runtime
# (not -devel) because experiments call into pre-built ORT / Torch wheels;
# nothing here compiles CUDA kernels from source.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS gpu-base

# Re-introduce the AGE Postgres binaries on top of the CUDA layer. We copy
# rather than FROM-multi-stage-merge so the resulting image is a single
# CUDA-on-Ubuntu rootfs with Postgres + AGE installed under /usr/lib/postgresql.
COPY --from=pg-age /usr/lib/postgresql /usr/lib/postgresql
COPY --from=pg-age /usr/share/postgresql /usr/share/postgresql
COPY --from=pg-age /var/lib/postgresql /var/lib/postgresql
COPY --from=pg-age /docker-entrypoint-initdb.d /docker-entrypoint-initdb.d
COPY --from=pg-age /docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Python + experiment dependencies. Versions are pinned LOOSELY in the scout;
# the first downstream issue tightens them once a real workload is wired.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3.11 python3-pip python3.11-venv \
        libpq-dev build-essential ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# GPU paging conventions (see docs/engineering.md → "GPU paging conventions"):
#   - Embedding cache lives under /var/cache/nexum/embed and is mounted as a
#     tmpfs at runtime; the container assumes ephemeral storage.
#   - Postgres data dir is the default /var/lib/postgresql/data and is the
#     only durable mount.
#   - Model weights are cached under /var/cache/nexum/models and SHOULD be a
#     read-only bind mount in production.
RUN mkdir -p /var/cache/nexum/embed /var/cache/nexum/models \
 && chown -R postgres:postgres /var/cache/nexum

# The scout does NOT install torch / onnxruntime-gpu — those are large and
# their exact version is decided by the consuming issue. The downstream
# issues append a final RUN with the resolved pip set.

USER postgres
ENV PATH="/usr/lib/postgresql/16/bin:${PATH}"
EXPOSE 5432

# Default to the upstream entrypoint so `docker run nexum/runtime-gpu` boots
# Postgres + AGE. GPU experiments override CMD with their own driver script.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["postgres"]
